+GATE_TESTS = "ITFeesExchangeBasic,ITExchangeCoreIntegrationRejectionBasic"
+GATE_TIMEOUT = 600
+GATE_MIN_TESTS = 33  # 5 + 28 shipped tests
 
 # For delombok (mvn main process) — needs exports to javac internals
