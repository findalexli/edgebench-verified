+def _strict_class_id(nid: str, x) -> int:
+    """Integer class id: int-like values, integral finite floats, or decimal-integer strings."""
+    if isinstance(x, bool):
+        raise ValueError(f"prediction for node {nid!r} is not an integer class id: {x!r}")
+    if isinstance(x, float):
+        if x != x or x in (float("inf"), float("-inf")) or not x.is_integer():
+            raise ValueError(f"prediction for node {nid!r} is not an integer class id: {x!r}")
+        return int(x)
+    if isinstance(x, str):
+        try:
+            return int(x.strip())
+        except ValueError:
+            raise ValueError(f"prediction for node {nid!r} is not an integer class id: {x!r}") from None
+    try:
+        return operator.index(x)
