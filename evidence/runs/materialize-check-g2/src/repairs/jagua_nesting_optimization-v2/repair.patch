+def _common_length(ia: list[tuple[float, float]], ib: list[tuple[float, float]]) -> float:
+    total = 0.0
+    i = j = 0
+    while i < len(ia) and j < len(ib):
+        lo = max(ia[i][0], ib[j][0])
+        hi = min(ia[i][1], ib[j][1])
+        if hi > lo:
+            total += hi - lo
+        if ia[i][1] <= ib[j][1]:
+            i += 1
+        else:
+            j += 1
+    return total
