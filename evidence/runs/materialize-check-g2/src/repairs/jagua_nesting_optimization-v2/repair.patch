+def _cross_section(edges, x: float) -> list[tuple[float, float]] | None:
+    """Interior intervals of a simple polygon on the vertical line at x (x is no vertex)."""
+    ys = sorted(y0 + (y1 - y0) * (x - x0) / (x1 - x0) for (x0, y0, x1, y1) in edges)
+    if len(ys) % 2:
+        return None
+    return [(ys[k], ys[k + 1]) for k in range(0, len(ys), 2)]
