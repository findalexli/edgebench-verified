+HTTP_DATE_RE = re.compile(
+    r"(Mon|Tue|Wed|Thu|Fri|Sat|Sun), ([0-9]{2}) "
+    r"(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) "
+    r"([0-9]{4}) ([0-9]{2}):([0-9]{2}):([0-9]{2}) GMT"
+)
+
+
+def is_imf_fixdate(value):
+    """IMF-fixdate shape, real Gregorian date, matching weekday, clock bounds (RFC 9110 5.6.7, RFC 5322 3.3)."""
+    match = HTTP_DATE_RE.fullmatch(value) if isinstance(value, str) else None
+    if match is None:
+        return False
+    weekday, day, month, year, hour, minute, second = match.groups()
+    months = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
+    weekdays = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+    year, month, day = int(year), months.index(month) + 1, int(day)
+    if year < 1900 or not 1 <= day <= calendar.monthrange(year, month)[1]:
+        return False
+    return (
+        weekdays[calendar.weekday(year, month, day)] == weekday
+        and 0 <= int(hour) <= 23
+        and 0 <= int(minute) <= 59
+        and 0 <= int(second) <= 60
+        and (int(second) != 60 or (int(hour) == 23 and int(minute) == 59))
+    )
+
+
 RANGE_SPEC_PAT = r"(\d+-\d+|-\d+|\d+-)"
