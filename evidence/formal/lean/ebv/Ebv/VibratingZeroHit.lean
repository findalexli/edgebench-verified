theorem certs_length : certs.length = 37 := by decide

/-- Every certificate is a well-formed (K+1)-clique (checked by the kernel). -/
theorem certs_wf : ∀ c ∈ certs, c.WF := by decide

/-- Main result: on each of the 37 certified official cases, if the certificate pairs are edges
of the case (script-checked, `vibrating_certs.out`), no zero-hit output is accepted. -/
theorem no_zero_hit_answer (c : Cert) (hc : c ∈ certs) (edges : List (ℕ × ℕ))
    (hsub : ∀ p ∈ c.pairs, p ∈ edges) (colors : List ℕ) : ¬ Q0Accepts c.N c.K edges colors :=
  cert_blocks_q0 c (certs_wf c hc) edges hsub colors

/-- The certified cases cover K = 1, 2 for all sizes and K = 3, 4 only for N = 1000. -/
theorem certs_cover :
    (certs.filter (fun c => c.K ≤ 2)).length = 25 ∧
    (certs.filter (fun c => 3 ≤ c.K ∧ c.N = 1000)).length = 12 := by decide

/-! ## Counter-checks (must come out the other way) -/

/-- The model is not vacuous: the authored bipartite 4-path (inputs/bip4.txt, K = 2) has an
accepted zero-hit colouring, matching the tester's `Score = 0` on `bip4.two_line.out`. -/
theorem counter_bip4_accepted : Q0Accepts 4 2 [(1, 2), (2, 3), (3, 4)] [1, 2, 1, 2] := by decide

/-- A K-clique (one vertex short) does not block: a triangle is 3-colourable. -/
theorem counter_triangle_k3 : Q0Accepts 3 3 [(1, 2), (2, 3), (1, 3)] [1, 2, 3] := by decide

/-- A certificate with one pair dropped is rejected by the well-formedness check. -/
theorem counter_mutated_cert :
    ¬ (Cert.WF ⟨"0003.txt", 1000, 3, [737, 738, 781, 784],
      [(737, 738), (737, 781), (737, 784), (738, 781), (738, 784)]⟩) := by decide

/-- A K-clique offered as a certificate for K (too small) is rejected. -/
theorem counter_small_cert : ¬ (Cert.WF ⟨"x", 1000, 3, [1, 2, 3], [(1, 2), (1, 3), (2, 3)]⟩) := by
  decide

/-! ## Executable model of the Q ≤ 0 parsing path, for the differential check -/

/-- Python `str.split()` (whitespace) on one line, approximated by spaces/tabs. -/
def pyWords (s : String) : List String :=
  ((s.splitOn " ").flatMap (·.splitOn "\t")).filter (· ≠ "")

/-- Tester lines 41-73 and 151-157 for an output whose first line is "0". -/
def testerQ0 (N K : ℕ) (edges : List (ℕ × ℕ)) (out : String) : Bool :=
  let lines := out.trimAscii.toString.splitOn "\n"
  if lines.length < 2 then false else
  let colors := (pyWords (lines.getD 1 "")).map String.toNat!
  decide (lines.getD 0 "" = "0") && decide (colors.length = N) &&
    colors.all (fun c => 1 ≤ c && c ≤ K) &&
    edges.all (fun e => colors.getD (e.1 - 1) 0 != colors.getD (e.2 - 1) 0)

