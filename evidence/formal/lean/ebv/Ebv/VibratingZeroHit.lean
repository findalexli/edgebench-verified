import Mathlib.Data.Finset.Card
import Mathlib.Order.Interval.Finset.Nat

/-! # vibrating_path_graph_coloring: a zero-hit answer is wrong on 37 of the 50 official cases

Claim. On 37 of the 50 official cases, every zero-hit (Q = 0) output is rejected by the tester,
whatever colouring it gives and whichever line form it uses; so the two-line/three-line mismatch
cannot change those cases' scores. Proof: each of these cases contains a (K+1)-clique
(K2 for K=1, a triangle for K=2, K4 for K=3, K5 for K=4), and the tester's Q = 0 path demands a
proper K-colouring of the whole graph. The other 13 cases (N=10000, K∈{3,4}) are NOT covered here.

Source modelled: `tools/bin/tester` (a Python script; identical in judge image
`seededge/edgebench.judge.vibrating_path_graph_coloring@sha256:db8a9741...084e` and work image),
sha256 b1c7694b8de3444c0459393b967851ad7d61e38a9a320222ce01ba7a1b446463.
* lines 41, 46, 54-59: `out_lines = strip().split('\n')`; Q = int(line 0); for Q <= 0 the colour
  line is `out_lines[1]` and `hit_nodes = []`. Three-line README form "0\n\nC" makes the colour
  line "" (modelled by `testerQ0`).
* lines 61-73: |colours| = N and every colour in [1, K].
* lines 75-149: with no hits, `removed_edges` stays empty.
* lines 151-157: every input edge must have distinct endpoint colours.
`Q0Accepts` is the conjunction of 61-73 and 151-157 for Q = 0 (the necessary condition for
"Score = 0"). Edges are 1-indexed as in the case file; the tester's `colors[u]` with 0-indexed
`u = file_u - 1` is `colors.getD (file_u - 1) 0`.

Data link. `certs` is generated by `evidence/formal/scripts/vibrating_certs.py` from the case
files in the work image (`cases/*.txt`, aggregate `sha256sum cases/*.txt | sha256sum` =
d2e7d7425f86bc08dc9eb21db3cfbb3de19b434a86b967bd14137606f0342545, as in the review). That script
also records each case's sha256 and the 0-based edge-list index of every certificate pair, and
re-reads each pair from the raw tokens (`evidence/formal/scripts/vibrating_certs.out`). That edge
membership is a script check, not part of the Lean proof: the theorems take it as hypothesis
`hsub`. -/

namespace Ebv.Vibrating

structure Cert where
  case : String
  N : ℕ
  K : ℕ
  verts : List ℕ
  pairs : List (ℕ × ℕ)

/-- Tester acceptance condition on the Q = 0 path (tester lines 61-73 and 151-157). -/
def Q0Accepts (N K : ℕ) (edges : List (ℕ × ℕ)) (colors : List ℕ) : Prop :=
  colors.length = N ∧ (∀ c ∈ colors, 1 ≤ c ∧ c ≤ K) ∧
  ∀ e ∈ edges, colors.getD (e.1 - 1) 0 ≠ colors.getD (e.2 - 1) 0

instance (N K : ℕ) (edges : List (ℕ × ℕ)) (colors : List ℕ) :
    Decidable (Q0Accepts N K edges colors) := by unfold Q0Accepts; infer_instance

/-- A certificate is a (K+1)-clique: distinct vertices in [1, N], every two joined by a listed pair. -/
def Cert.WF (c : Cert) : Prop :=
  c.verts.Nodup ∧ c.verts.length = c.K + 1 ∧ (∀ v ∈ c.verts, 1 ≤ v ∧ v ≤ c.N) ∧
  ∀ a ∈ c.verts, ∀ b ∈ c.verts, a ≠ b → (a, b) ∈ c.pairs ∨ (b, a) ∈ c.pairs

instance (c : Cert) : Decidable c.WF := by unfold Cert.WF; infer_instance

/-- General lemma: a graph containing a (K+1)-clique has no accepted zero-hit output. -/
theorem clique_blocks_q0 (N K : ℕ) (vs : List ℕ) (hnd : vs.Nodup) (hlen : vs.length = K + 1)
    (hr : ∀ v ∈ vs, 1 ≤ v ∧ v ≤ N) (edges : List (ℕ × ℕ))
    (hadj : ∀ a ∈ vs, ∀ b ∈ vs, a ≠ b → (a, b) ∈ edges ∨ (b, a) ∈ edges)
    (colors : List ℕ) : ¬ Q0Accepts N K edges colors := by
  rintro ⟨hl, hc, he⟩
  let col : ℕ → ℕ := fun v => colors.getD (v - 1) 0
  have hmaps : Set.MapsTo col (vs.toFinset : Set ℕ) (Finset.Icc 1 K : Set ℕ) := by
    intro v hv
    have hv' : v ∈ vs := by simpa using hv
    obtain ⟨h1, h2⟩ := hr v hv'
    have hlt : v - 1 < colors.length := by omega
    have hmem : col v ∈ colors := by
      simp only [col, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlt, Option.getD_some]
      exact List.getElem_mem hlt
    obtain ⟨c1, c2⟩ := hc _ hmem
    simp only [Finset.coe_Icc, Set.mem_Icc]
    exact ⟨c1, c2⟩
  have hcard : (Finset.Icc 1 K).card < vs.toFinset.card := by
    rw [List.toFinset_card_of_nodup hnd, hlen, Nat.card_Icc]; omega
  obtain ⟨x, hx, y, hy, hxy, hcol⟩ := Finset.exists_ne_map_eq_of_card_lt_of_maps_to hcard hmaps
  have hx' : x ∈ vs := by simpa using hx
  have hy' : y ∈ vs := by simpa using hy
  rcases hadj x hx' y hy' hxy with h | h
  · exact he _ h hcol
  · exact he _ h hcol.symm

/-- The certificate's own pairs make it a clique in any edge list containing them. -/
theorem cert_blocks_q0 (c : Cert) (hwf : c.WF) (edges : List (ℕ × ℕ))
    (hsub : ∀ p ∈ c.pairs, p ∈ edges) (colors : List ℕ) : ¬ Q0Accepts c.N c.K edges colors := by
  obtain ⟨hnd, hlen, hr, hadj⟩ := hwf
  exact clique_blocks_q0 c.N c.K c.verts hnd hlen hr edges
    (fun a ha b hb hab => (hadj a ha b hb hab).imp (hsub _) (hsub _)) colors

