/-
Non-vacuity, negative control and differential test for Ebv/WarehouseBound.lean.
-/
import Ebv.WarehouseBound

namespace EbvWarehouse

/-! ### Non-vacuity / negative control

On the 2x3 instance with arrivals 1 2 3 4 5 the following 42-character string is accepted
by this model (checked by `decide`), so the too-strong bound S ≥ 2RC(R+C-1) - 2 = 46
is FALSE, while the proved bound gives 28 ≤ 42. -/

def ship23 : ℕ → ℕ := fun i => i + 1

/-- Executable acceptance check (used for non-vacuity and for the differential test). -/
def accepts? (R C : ℕ) (ship : ℕ → ℕ) (str : List Char) : Bool :=
  match parse str with
  | none => false
  | some cs =>
      match run R C ship init cs with
      | none => false
      | some e => e.disp == R * C - 1

theorem accepts_of_check (R C : ℕ) (ship : ℕ → ℕ) (str : List Char)
    (h : accepts? R C ship str = true) : Accepts R C ship str := by
  unfold accepts? at h
  split at h
  · simp at h
  · rename_i cs hcs
    split at h
    · simp at h
    · rename_i e he
      exact ⟨cs, e, hcs, he, by simpa using h⟩

/-- Brute-force optimum for 2x3, arrivals 1 2 3 4 5 (found by brute_force.py, accepted by the
    original tester). -/
def opt23 : List Char := "PEUWWPEUEWPEUSWPUEPUSELWWDELEWDELSWDLEDLSD".toList

theorem opt23_len : opt23.length = 42 := by decide +kernel

theorem opt23_accepted : Accepts 2 3 ship23 opt23 :=
  accepts_of_check 2 3 ship23 opt23 (by decide +kernel)

/-- The proved bound is consistent with it: L(2,3) = 28 ≤ 42. -/
example : 2 * ((2 : ℕ) : ℤ) * ((3 : ℕ) : ℤ) * (((2 : ℕ) : ℤ) + ((3 : ℕ) : ℤ) - 1)
    - 6 * (((2 : ℕ) : ℤ) + ((3 : ℕ) : ℤ) - 2) - 2 = 28 := by norm_num

/-- Negative control: the too-strong bound S ≥ 2RC(R+C-1) - 2 (= 46 on 2x3) is false. -/
theorem too_strong_bound_false :
    ¬ (∀ str : List Char, Accepts 2 3 ship23 str → 2 * 2 * 3 * (2 + 3 - 1) - 2 ≤ str.length) := by
  intro h
  have := h opt23 opt23_accepted
  rw [opt23_len] at this
  norm_num at this

/-- Sanity: a one-character truncation of the optimum is rejected (the model is not trivially
    accepting). -/
theorem opt23_drop_last_rejected : accepts? 2 3 ship23 (opt23.dropLast) = false := by decide +kernel

