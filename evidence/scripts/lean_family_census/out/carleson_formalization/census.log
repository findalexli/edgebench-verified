5:/- THIS IS NEW VERSION OF LISTDECLAXIOM THAT CALCULATE HASH OF DECLARATION.-/
50:def isModuleUnderPrefix (modulePrefix : String) (moduleName : Name) : Bool :=
52:  moduleNameString == modulePrefix || moduleNameString.startsWith (modulePrefix ++ ".")
103:def analysisDecls (modulePrefix : String) : MetaM (Array Name) := do
108:    if isModuleUnderPrefix modulePrefix moduleName then
114:def projectDeclSet (modulePrefix : String) : MetaM (Std.HashSet Name) := do
115:  let decls ← analysisDecls modulePrefix
227:def targetSpecClosureHash (modulePrefix : String) (target : Name) : MetaM UInt64 := do
228:  let projectDecls ← projectDeclSet modulePrefix
230:    throwError "no declarations found for module prefix {modulePrefix}"
232:    throwError "target {target} is not a declaration from modules matching prefix {modulePrefix}"
