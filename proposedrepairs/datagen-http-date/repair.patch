+def is_imf_fixdate(value):
+    """Check IMF-fixdate shape, Gregorian date, weekday, and clock bounds.
+
+    Require years from 1900 and allow second 60 only at 23:59 GMT. This
+    does not certify leap-second occurrence on that particular date.
+    """
+    if not isinstance(value, str):
+        return False
+    match = HTTP_DATE_RE.fullmatch(value)
+    if match is None:
+        return False
+    weekday, day, month, year, hour, minute, second = match.groups()
+    months = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
+    weekdays = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+    year, month, day = int(year), months.index(month) + 1, int(day)
+    if year < 1900 or not 1 <= day <= calendar.monthrange(year, month)[1]:
+        return False
+    return (
+        weekdays[calendar.weekday(year, month, day)] == weekday
+        and 0 <= int(hour) <= 23
+        and 0 <= int(minute) <= 59
+        and 0 <= int(second) <= 60
+        and (int(second) != 60 or (int(hour) == 23 and int(minute) == 59))
+    )
 RANGE_SPEC_PAT = r"(\d+-\d+|-\d+|\d+-)"
 VALID_RANGE_RE = re.compile(rf"^bytes={RANGE_SPEC_PAT}(,{RANGE_SPEC_PAT})*$")
 
