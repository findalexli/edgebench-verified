+# Versioned policy: decimal 1 GB of virtual address space per solution process.
+# This is not RSS accounting or a combined descendant/process-tree budget.
+SOLUTION_ADDRESS_SPACE_BYTES = 1_000_000_000
+
+
+def _limit_solution_address_space():
+    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
+    limits = [SOLUTION_ADDRESS_SPACE_BYTES]
+    limits.extend(value for value in (soft, hard) if value != resource.RLIM_INFINITY)
+    limit = min(limits)
+    resource.setrlimit(resource.RLIMIT_AS, (limit, limit))
+
