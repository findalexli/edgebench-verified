@@ -1,4 +1,7 @@
-"""Bowyer-Watson Delaunay triangulation (pure Python, no scipy)."""
+"""Bowyer-Watson Delaunay triangulation (pure Python, no scipy).
+
+EdgeBench Verified v2.2: the result covers the convex hull of the points (see complete_hull).
+"""
 
 from __future__ import annotations
 
@@ -89,4 +92,139 @@
     for a, b, c in triangles:
         if a < n and b < n and c < n:
             result.append(normalize_triangle(a, b, c))
-    return result
+    return complete_hull(points, result)
+
+
+# --- EdgeBench Verified v2.2: cover the whole convex hull (exact integer arithmetic) ---
+# The super-triangle above is finite, so Bowyer-Watson can drop triangles next to the convex
+# hull: the result is then a triangulated polygon of all points, not a triangulation of the
+# point set. complete_hull() triangulates each uncovered pocket between the mesh boundary and
+# the hull (ear clipping), then restores the Delaunay property with Lawson flips. Every test is
+# an exact integer determinant. It returns its input unchanged when the hull is already covered
+# and every edge is already locally Delaunay.
+
+
+def _orient(p: Point, q: Point, r: Point) -> int:
+    return (q[0] - p[0]) * (r[1] - p[1]) - (q[1] - p[1]) * (r[0] - p[0])
+
+
+def _in_circle(a: Point, b: Point, c: Point, d: Point) -> int:
+    """> 0 iff d is strictly inside the circumcircle of the counter-clockwise triangle abc."""
+    adx, ady = a[0] - d[0], a[1] - d[1]
+    bdx, bdy = b[0] - d[0], b[1] - d[1]
+    cdx, cdy = c[0] - d[0], c[1] - d[1]
+    return ((adx * adx + ady * ady) * (bdx * cdy - cdx * bdy)
+            - (bdx * bdx + bdy * bdy) * (adx * cdy - cdx * ady)
+            + (cdx * cdx + cdy * cdy) * (adx * bdy - bdx * ady))
+
+
+def _hull_ccw(points: Sequence[Point]) -> List[int]:
+    """Indices of the strict convex hull, counter-clockwise (monotone chain)."""
+    order = sorted(range(len(points)), key=lambda i: points[i])
+
+    def half(seq: List[int]) -> List[int]:
+        h: List[int] = []
+        for i in seq:
+            while len(h) >= 2 and _orient(points[h[-2]], points[h[-1]], points[i]) <= 0:
+                h.pop()
+            h.append(i)
+        return h
+
+    lower, upper = half(order), half(order[::-1])
+    return lower[:-1] + upper[:-1]
+
+
+def _ear_clip(points: Sequence[Point], poly: List[int]) -> List[Triangle]:
+    """Triangulate a simple counter-clockwise polygon given as point indices."""
+    poly = list(poly)
+    out: List[Triangle] = []
+    while len(poly) > 3:
+        m = len(poly)
+        for i in range(m):
+            a, b, c = poly[i - 1], poly[i], poly[(i + 1) % m]
+            pa, pb, pc = points[a], points[b], points[c]
+            if _orient(pa, pb, pc) <= 0:
+                continue
+            if any(_orient(pa, pb, points[x]) >= 0 and _orient(pb, pc, points[x]) >= 0
+                   and _orient(pc, pa, points[x]) >= 0 for x in poly if x not in (a, b, c)):
+                continue
+            out.append((a, b, c))
+            del poly[i]
+            break
+        else:
+            raise ValueError("hull pocket has no ear")
+    if _orient(points[poly[0]], points[poly[1]], points[poly[2]]) <= 0:
+        raise ValueError("degenerate hull pocket")
+    out.append((poly[0], poly[1], poly[2]))
+    return out
+
+
+def _apex(t: Triangle, u: int, v: int) -> int:
+    return next(x for x in t if x != u and x != v)
+
+
+def _lawson(points: Sequence[Point], tris: List[Triangle]) -> List[Triangle]:
+    """Flip every edge that is not locally Delaunay (exact in-circle test) until none is left.
+    Flipped triangles keep their list positions, so the output order is deterministic."""
+    tris = list(tris)
+    e2t: dict[Tuple[int, int], List[int]] = {}
+    for i, (a, b, c) in enumerate(tris):
+        for u, v in ((a, b), (b, c), (a, c)):
+            e2t.setdefault(_edge_key(u, v), []).append(i)
+    stack = sorted((e for e, ts in e2t.items() if len(ts) == 2), reverse=True)
+    while stack:
+        u, v = stack.pop()
+        ts = e2t.get((u, v))
+        if not ts or len(ts) != 2:
+            continue
+        i, j = ts
+        a, b = _apex(tris[i], u, v), _apex(tris[j], u, v)
+        x, y = (u, v) if _orient(points[u], points[v], points[a]) > 0 else (v, u)
+        if _in_circle(points[x], points[y], points[a], points[b]) <= 0:
+            continue
+        if not (_orient(points[a], points[b], points[u]) * _orient(points[a], points[b], points[v]) < 0):
+            raise ValueError("non-convex quadrilateral in Lawson flip")
+        for k in (i, j):
+            t = tris[k]
+            for p, q in ((t[0], t[1]), (t[1], t[2]), (t[0], t[2])):
+                e2t[_edge_key(p, q)].remove(k)
+        del e2t[(u, v)]
+        tris[i] = normalize_triangle(a, b, u)
+        tris[j] = normalize_triangle(a, b, v)
+        for k in (i, j):
+            t = tris[k]
+            for p, q in ((t[0], t[1]), (t[1], t[2]), (t[0], t[2])):
+                e2t.setdefault(_edge_key(p, q), []).append(k)
+        stack.extend([_edge_key(a, u), _edge_key(u, b), _edge_key(b, v), _edge_key(v, a)])
+    return tris
+
+
+def complete_hull(points: Sequence[Point], tris: List[Triangle]) -> List[Triangle]:
+    """Complete a triangulated polygon of all points to a Delaunay triangulation of their convex
+    hull (see the note above)."""
+    count: dict[Tuple[int, int], int] = {}
+    for a, b, c in tris:
+        for u, v in ((a, b), (b, c), (a, c)):
+            count[_edge_key(u, v)] = count.get(_edge_key(u, v), 0) + 1
+    nxt: dict[int, int] = {}
+    for a, b, c in tris:
+        if _orient(points[a], points[b], points[c]) < 0:
+            b, c = c, b
+        for u, v in ((a, b), (b, c), (c, a)):
+            if count[_edge_key(u, v)] == 1:
+                if u in nxt:
+                    raise ValueError("mesh boundary is not a simple cycle")
+                nxt[u] = v
+    hull = _hull_ccw(points)
+    added: List[Triangle] = []
+    for k, p in enumerate(hull):
+        q = hull[(k + 1) % len(hull)]
+        if nxt.get(p) == q:
+            continue
+        chain = [p]
+        while chain[-1] != q:
+            chain.append(nxt[chain[-1]])
+            if len(chain) > len(points):
+                raise ValueError("mesh boundary is not a simple cycle")
+        added.extend(_ear_clip(points, chain[::-1]))
+    return _lawson(points, list(tris) + [normalize_triangle(*t) for t in added])
