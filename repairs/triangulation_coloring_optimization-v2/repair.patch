 TESTER = os.path.join(WORK_DIR, "tools", "bin", "tester")
 TIME_LIMIT = 30
 
+
+def cpu_quota_workers():
+    """EBV v2: run at most as many cases at once as the grader has CPUs (cgroup quota), 1..8."""
+    n = None
+    try:  # cgroup v2: "<quota> <period>" or "max <period>"
+        with open("/sys/fs/cgroup/cpu.max") as f:
+            quota, period = f.read().split()[:2]
+        if quota != "max":
+            n = int(quota) // int(period)
+    except (OSError, ValueError):
+        pass
+    if n is None:
+        try:  # cgroup v1: quota -1 means no limit
+            with open("/sys/fs/cgroup/cpu/cpu.cfs_quota_us") as f:
+                quota = int(f.read())
+            with open("/sys/fs/cgroup/cpu/cpu.cfs_period_us") as f:
+                period = int(f.read())
+            if quota > 0:
+                n = quota // period
+        except (OSError, ValueError):
+            pass
+    if n is None:
+        n = os.cpu_count() or 1
+    return max(1, min(8, n))
