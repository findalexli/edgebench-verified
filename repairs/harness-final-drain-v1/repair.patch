+class FinalDrainError(RuntimeError):
+    """Authoritative final grading history could not be collected completely."""
+
+
+def _drain_final_history(url, token, secret, eval_timeout, logger):
+    # Bound serial service of the observed queue, with explicit setup grace.
+    # This is an operational bound, not a guarantee about backend scheduling.
+    started = time.monotonic()
+    deadline = started + 300
+    seen = set()
+    failures = 0
+    while True:
+        if time.monotonic() >= deadline:
+            raise FinalDrainError("Final grading drain incomplete: deadline expired")
+        try:
+            response = requests.get(
+                f"{url}/api/v1/history",
+                params={"token": token, "admin_secret": secret},
+                timeout=min(10, deadline - time.monotonic()),
+            )
+            response.raise_for_status()
+            history = response.json()
+            entries = history["entries"]
+            if not isinstance(entries, list):
+                raise ValueError("history entries must be a list")
+            pending = [e for e in entries if e.get("status") in ("running", "queued")]
+            identities = {e["submission_id"] for e in pending}
+            if any(not identity for identity in identities):
+                raise ValueError("pending submission has no identity")
+        except Exception as exc:
+            failures += 1
+            if failures >= 3:
+                raise FinalDrainError("Final grading drain incomplete: history unavailable") from exc
+            logger.warning("Final history request failed; retrying")
+        else:
+            failures = 0
+            # Extend once for each newly observed job, never on every poll.
+            unseen = identities - seen
+            deadline += len(unseen) * (max(0, eval_timeout) + 300)
+            seen.update(identities)
+            if time.monotonic() >= deadline:
+                raise FinalDrainError("Final grading drain incomplete: deadline expired")
+            if not pending:
+                return history
+            logger.info(f"Draining {len(pending)} pending judge evals...")
+        time.sleep(min(15, max(0, deadline - time.monotonic())))
 
 
